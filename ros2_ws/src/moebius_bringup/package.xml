<?xml version="1.0"?>
<package format="3">
  <name>moebius_bringup</name>
  <version>0.1.0</version>
  <description>Boot-time bringup, systemd deployment, and web serving files for MoebiusRobot.</description>
  <maintainer email="jarvis2603@users.noreply.github.com">jarvis2603</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moebius_base_driver</exec_depend>
  <exec_depend>moebius_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
